.vs/
Generated_Files/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.visualstudio.g.props
*.visualstudio.g.targets

# MSTest test Results
[Tt]est[Rr]esults/
*.trx

# JetBrains Rider / ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
