# ==============================================================================
# MIMO EDUCATION PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# 1. Ứng dụng & Môi trường runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ENABLE_SWAGGER=true
APPLY_MIGRATIONS=true

# 2. Local Database (Dùng cho Docker Compose cục bộ)
POSTGRES_DB=mimo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5433

# 3. Quản trị Cơ sở dữ liệu qua pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@mimo.app
PGADMIN_DEFAULT_PASSWORD=Admin123!
PGADMIN_PORT=5050

# 4. Chuỗi kết nối Database (EF Core Npgsql)
# - Dùng cho Local Docker Compose:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=mimo_db;Username=postgres;Password=postgrespassword
# - Dùng cho Cloud Supabase (Transaction Pooler - Port 6543 hoặc Session Pooler - Port 5432):
# ConnectionStrings__DefaultConnection=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.axbejjdzsuelscpkuwab;Password=YOUR_SUPABASE_DB_PASSWORD;Timeout=300;CommandTimeout=300

# 5. Redis Caching
# - Local:
ConnectionStrings__Redis=localhost:6379
# - Cloud Upstash Redis (nếu dùng):
# ConnectionStrings__Redis=YOUR_REDIS_ENDPOINT:6379,password=YOUR_PASSWORD,ssl=True,abortConnect=False

# 6. Bảo mật & Xác thực JWT
Jwt__Secret=0ebe2440a9eba77bed3a7a081b9bb26d792baaec3fcac1eae95b7148bfdcb8c5
Jwt__Issuer=MimoAPI
Jwt__Audience=MimoClient

# 7. Cloud Storage (Supabase Storage)
Supabase__Url=https://axbejjdzsuelscpkuwab.supabase.co
Supabase__ApiKey=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF4YmVqamR6c3VlbHNjcGt1d2FiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI1OTQwMTAsImV4cCI6MjEwODE3MDAxMH0.PWiw41N00U2pcpap0WdUzZ1gaqMzVOBLhJDC_H1_XrU
Supabase__BucketName=mimo-assets

# 8. Google OAuth (Đăng nhập Google)
GoogleAuth__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# 9. Dịch vụ gửi Email (Gmail SMTP)
MailSettings__Server=smtp.gmail.com
MailSettings__Port=587
MailSettings__SenderEmail=noreply@mimo.app
MailSettings__Password=YOUR_APP_SPECIFIC_PASSWORD
