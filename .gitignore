# ===================================================
# Root .gitignore for EXE201 Monorepo / Multi-project
# ===================================================

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Common IDE / Editor configs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates
*.user
*.userosscache

# Temporary and Log files
*.log
*.tmp
*.bak
*.swp

# Note: Specific ignore rules are located inside each project folder:
# - Mimo_EXE201_BE/.gitignore (Backend: .NET / C# / Visual Studio)
# - Mimo_EXE201_FE/.gitignore (Frontend: React / Vite / Next.js / Node.js)
